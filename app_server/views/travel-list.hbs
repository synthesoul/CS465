<!DOCTYPE html>
<html>
  <head>
    <title>{{title}}</title>
  </head>
  <body>
    <h1>{{pageHeader.title}}</h1>
    <p>{{pageHeader.strapline}}</p>

    <ul>
      {{#each travels}}
        <li>
          <strong>{{name}}</strong><br>
          Price: ${{price}}<br>
          Location: {{location}}<br>
          {{description}}
        </li>
      {{/each}}
    </ul>
  </body>
</html>
